// polish lexer: Crush source -> tokens that keep comments, whitespace gaps and
// exact positions. Mirrors crush-frontend's parser/lexer.rs (v0.9.0).
//
// Token: { k, t, ws, line, col }  (+ c on keywords)
//   k    id | kw | num | str | op | cm | nl | at | lang | eof
//   t    exact source text of the token
//   ws   whitespace (same line) that preceded the token in the source
//   line, col   1-based; col counts characters (Unicode scalars), like crushc
// Keywords also carry c, the canonical English keyword (aliases map onto it).
// A polyglot block (`@python[deps] -> out { ... }`) is ONE `lang` token whose
// text is copied byte for byte.
//
// Keep every map literal on one line (crush-ast CRUSH-345).

fn __polish_tok(k, t, ws, line, col) {
    return { k: k, t: t, ws: ws, line: line, col: col }
}

fn __polish_is_digit(ch) {
    return ch >= "0" && ch <= "9"
}

fn __polish_is_hex(ch) {
    if ch >= "0" && ch <= "9" { return true }
    if ch >= "a" && ch <= "f" { return true }
    if ch >= "A" && ch <= "F" { return true }
    return false
}

// letters, digits, `_`, and every non-ASCII character (approximation of
// Rust's is_alphanumeric for characters outside ASCII)
fn __polish_is_alnum(ch) {
    if ch == "" { return false }
    if ch >= "a" && ch <= "z" { return true }
    if ch >= "A" && ch <= "Z" { return true }
    if ch >= "0" && ch <= "9" { return true }
    if ch == "_" { return true }
    if ch > "~" { return true }
    return false
}

fn __polish_is_space(ch) {
    return ch == " " || ch == "\t" || ch == "\r"
}

// canonical keyword for an identifier-shaped word, or "" when it is not one
fn polish_kw(w) {
    if w == "let" || w == "manau" || w == "设" || w == "させ" { return "let" }
    if w == "fn" || w == "karya" || w == "函数" || w == "関数" { return "fn" }
    if w == "if" || w == "yadi" || w == "如果" || w == "もし" { return "if" }
    if w == "else" || w == "natra" || w == "否则" || w == "それ以外" { return "else" }
    if w == "while" || w == "jaba_samma" || w == "只要" || w == "間" { return "while" }
    if w == "return" || w == "farkau" || w == "返回" || w == "戻る" { return "return" }
    if w == "true" || w == "sahi" || w == "真" || w == "本当" { return "true" }
    if w == "false" || w == "galat" || w == "假" || w == "偽" { return "false" }
    let plain = ["mut", "for", "in", "try", "catch", "throw", "break", "continue", "struct", "use", "capability", "async", "await", "spawn", "yield", "new", "export", "lang", "import", "match", "null", "and", "or", "not"]
    if collections.includes(plain, w) { return w }
    return ""
}

fn __polish_import_kw(id) {
    let names = ["mcp", "cap", "lang", "git", "http", "file", "module", "invariant", "exhaustive-match-sites", "errors", "reads", "writes", "does-not-write", "covers", "relies-on", "complexity", "wip", "temporary", "decision", "invalidates", "must-call-before", "must-call-after", "kind"]
    return collections.includes(names, id)
}

fn __polish_is_dep_char(ch) {
    if ch == "" { return false }
    if __polish_is_alnum(ch) && ch != "_" { return true }
    return collections.includes(["_", "-", ".", ":", "@", "/", "^", "~", "*", "=", "<", ">"], ch)
}

fn __polish_join(cs, a, b) {
    return str.join(cs[a:b], "")
}

fn __polish_skip_any_ws(cs, i) {
    let n = len(cs)
    while i < n {
        let ch = cs[i]
        if ch == " " || ch == "\t" || ch == "\r" || ch == "\n" { i = i + 1 } else { return i }
    }
    return i
}

// `[dep, dep]` starting on `[`; returns index after `]`, or -1 when malformed
fn __polish_dep_list_end(cs, i) {
    let n = len(cs)
    i = i + 1
    while true {
        i = __polish_skip_any_ws(cs, i)
        if i >= n { return -1 }
        if cs[i] == "]" { return i + 1 }
        if !__polish_is_dep_char(cs[i]) { return -1 }
        while i < n && __polish_is_dep_char(cs[i]) { i = i + 1 }
        i = __polish_skip_any_ws(cs, i)
        if i >= n { return -1 }
        if cs[i] == "," { i = i + 1 } else if cs[i] == "]" { return i + 1 } else { return -1 }
    }
    return -1
}

fn __polish_out_ident_end(cs, i) {
    let n = len(cs)
    let j = i
    while j < n && __polish_is_alnum(cs[j]) { j = j + 1 }
    if j == i { return -1 }
    return j
}

// output list after `->`; index after it, or -1
fn __polish_out_list_end(cs, i) {
    let n = len(cs)
    i = __polish_skip_any_ws(cs, i)
    if i < n && cs[i] == "(" {
        i = i + 1
        while true {
            i = __polish_skip_any_ws(cs, i)
            i = __polish_out_ident_end(cs, i)
            if i < 0 { return -1 }
            i = __polish_skip_any_ws(cs, i)
            if i >= n { return -1 }
            if cs[i] == "," { i = i + 1 } else if cs[i] == ")" { return i + 1 } else { return -1 }
        }
    }
    return __polish_out_ident_end(cs, i)
}

// index just after the closing quote of a quoted run starting at i (-1: unterminated)
fn __polish_quoted_end(cs, i, quote) {
    let n = len(cs)
    i = i + 1
    while i < n {
        let ch = cs[i]
        if ch == "\\" { i = i + 2 } else if ch == quote { return i + 1 } else { i = i + 1 }
    }
    return -1
}

fn __polish_triple_end(cs, i, quote) {
    let n = len(cs)
    i = i + 3
    while i < n {
        if cs[i] == quote && i + 2 < n && cs[i + 1] == quote && cs[i + 2] == quote { return i + 3 }
        i = i + 1
    }
    return -1
}

// index after the `}` closing a polyglot body; i is just past the opening `{`.
// -1 on EOF.
fn __polish_lang_body_end(cs, i) {
    let n = len(cs)
    let depth = 1
    while i < n {
        let ch = cs[i]
        if ch == "{" {
            depth = depth + 1
            i = i + 1
        } else if ch == "}" {
            depth = depth - 1
            i = i + 1
            if depth == 0 { return i }
        } else if ch == "\"" || ch == "'" {
            if i + 2 < n && cs[i + 1] == ch && cs[i + 2] == ch {
                i = __polish_triple_end(cs, i, ch)
            } else {
                i = __polish_quoted_end(cs, i, ch)
            }
            if i < 0 { return -1 }
        } else if ch == "`" {
            i = __polish_quoted_end(cs, i, "`")
            if i < 0 { return -1 }
        } else {
            i = i + 1
        }
    }
    return -1
}

// advance line/col over cs[a:b]; returns [line, col]
fn __polish_advance(cs, a, b, line, col) {
    let i = a
    while i < b {
        if cs[i] == "\n" {
            line = line + 1
            col = 1
        } else {
            col = col + 1
        }
        i = i + 1
    }
    return [line, col]
}

// lex(src) -> { ok, toks, spans, err_line, err_col, err_msg }
//   spans: [first_line, last_line] of every multi-line string / polyglot token
//          (their inner newlines are data, not layout)
fn polish_lex(src) {
    let cs = str.split(src, "")
    let n = len(cs)
    let toks = []
    let spans = []
    let i = 0
    let line = 1
    let col = 1
    let ws_start = 0
    while true {
        // whitespace on this line
        ws_start = i
        while i < n && __polish_is_space(cs[i]) { i = i + 1 }
        let ws = __polish_join(cs, ws_start, i)
        col = col + (i - ws_start)
        if i >= n {
            toks.push(__polish_tok("eof", "", ws, line, col))
            return { ok: true, toks: toks, spans: spans, err_line: 0, err_col: 0, err_msg: "" }
        }
        let ch = cs[i]
        let start = i
        if ch == "\n" {
            toks.push(__polish_tok("nl", "\n", ws, line, col))
            i = i + 1
            line = line + 1
            col = 1
        } else if ch == "\"" || ch == "'" {
            let e = __polish_quoted_end(cs, i, ch)
            if e < 0 { return polish_lex_fail(line, col, "unterminated string") }
            let lc = __polish_advance(cs, i, e, line, col)
            toks.push(__polish_tok("str", __polish_join(cs, i, e), ws, line, col))
            if lc[0] > line { spans.push([line, lc[0]]) }
            i = e
            line = lc[0]
            col = lc[1]
        } else if __polish_is_digit(ch) {
            let e = i
            let kind = "num"
            if ch == "0" && i + 1 < n && (cs[i + 1] == "x" || cs[i + 1] == "X") {
                e = i + 2
                while e < n && __polish_is_hex(cs[e]) { e = e + 1 }
                if e == i + 2 { return polish_lex_fail(line, col, "invalid number") }
            } else if ch == "0" && i + 1 < n && (cs[i + 1] == "b" || cs[i + 1] == "B") {
                e = i + 2
                while e < n && (cs[e] == "0" || cs[e] == "1") { e = e + 1 }
                if e == i + 2 { return polish_lex_fail(line, col, "invalid number") }
            } else {
                while e < n && __polish_is_digit(cs[e]) { e = e + 1 }
                if e + 1 < n && cs[e] == "." && __polish_is_digit(cs[e + 1]) {
                    e = e + 1
                    while e < n && __polish_is_digit(cs[e]) { e = e + 1 }
                }
            }
            toks.push(__polish_tok(kind, __polish_join(cs, i, e), ws, line, col))
            col = col + (e - i)
            i = e
        } else if ch == "b" && i + 1 < n && cs[i + 1] == "\"" {
            return polish_lex_fail(line, col, "bytes literals (b\"...\") are not supported")
        } else if __polish_is_alnum(ch) && !__polish_is_digit(ch) {
            let e = i
            while e < n && __polish_is_alnum(cs[e]) { e = e + 1 }
            let w = __polish_join(cs, i, e)
            let c = polish_kw(w)
            if c == "" {
                toks.push(__polish_tok("id", w, ws, line, col))
            } else {
                let tk = __polish_tok("kw", w, ws, line, col)
                tk.c = c
                toks.push(tk)
            }
            col = col + (e - i)
            i = e
        } else if ch == "#" || (ch == "/" && i + 1 < n && cs[i + 1] == "/") {
            let e = i
            while e < n && cs[e] != "\n" { e = e + 1 }
            toks.push(__polish_tok("cm", __polish_join(cs, i, e), ws, line, col))
            col = col + (e - i)
            i = e
        } else if ch == "@" {
            let e = i + 1
            while e < n && (__polish_is_alnum(cs[e]) || cs[e] == "-") { e = e + 1 }
            if e == i + 1 { return polish_lex_fail(line, col + 1, "expected identifier after @") }
            let id = __polish_join(cs, i + 1, e)
            // is it a polyglot block?
            let end = -1
            if !__polish_import_kw(id) {
                let j = __polish_skip_any_ws(cs, e)
                let ok = true
                if j < n && cs[j] == "[" {
                    j = __polish_dep_list_end(cs, j)
                    if j < 0 { ok = false }
                }
                if ok {
                    j = __polish_skip_any_ws(cs, j)
                    if j + 1 < n && cs[j] == "-" && cs[j + 1] == ">" {
                        j = __polish_out_list_end(cs, j + 2)
                        if j < 0 { ok = false }
                    }
                }
                if ok {
                    j = __polish_skip_any_ws(cs, j)
                    if j < n && cs[j] == "{" {
                        let be = __polish_lang_body_end(cs, j + 1)
                        if be < 0 { return polish_lex_fail(line, col, "unterminated polyglot block") }
                        end = be
                    }
                }
            }
            if end < 0 {
                toks.push(__polish_tok("at", __polish_join(cs, i, e), ws, line, col))
                col = col + (e - i)
                i = e
            } else {
                let lc = __polish_advance(cs, i, end, line, col)
                toks.push(__polish_tok("lang", __polish_join(cs, i, end), ws, line, col))
                if lc[0] > line { spans.push([line, lc[0]]) }
                i = end
                line = lc[0]
                col = lc[1]
            }
        } else {
            let two = ""
            let three = ""
            if i + 1 < n { two = ch + cs[i + 1] }
            if i + 2 < n { three = two + cs[i + 2] }
            let op = ""
            if three == "..=" {
                op = three
            } else if two == "==" || two == "!=" || two == "<=" || two == ">=" || two == "&&" || two == "||" || two == "|>" || two == "->" || two == "=>" || two == "::" || two == ".." {
                op = two
            } else if collections.includes(["+", "-", "*", "/", "%", "<", ">", "!", "=", "|", "(", ")", "{", "}", "[", "]", ",", ":", ";", ".", "?", "&"], ch) {
                op = ch
            } else {
                return polish_lex_fail(line, col, "unexpected character: " + ch)
            }
            toks.push(__polish_tok("op", op, ws, line, col))
            let w = len(str.split(op, ""))
            col = col + w
            i = i + w
        }
    }
    return { ok: true, toks: toks, spans: spans, err_line: 0, err_col: 0, err_msg: "" }
}

fn polish_lex_fail(line, col, msg) {
    return { ok: false, toks: [], spans: [], err_line: line, err_col: col, err_msg: msg }
}
